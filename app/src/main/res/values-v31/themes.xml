<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ods" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Системная заставка Android 12+: только фон, без иконки — дальше идёт своя заставка -->
        <item name="android:windowSplashScreenBackground">@color/navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
